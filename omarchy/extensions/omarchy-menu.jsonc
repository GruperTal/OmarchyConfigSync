  "install.style.font.cascadia": {"icon":"","label":"Cascadia Mono","action":"~/Work/omarchy-update-ui/omarchy-update-ui omarchy-install-font 'Cascadia Mono' ttf-cascadia-mono-nerd 'CaskaydiaMono Nerd Font'"},
  "install.style.font.meslo": {"icon":"","label":"Meslo LG Mono","action":"~/Work/omarchy-update-ui/omarchy-update-ui omarchy-install-font 'Meslo LG Mono' ttf-meslo-nerd 'MesloLGL Nerd Font'"},
  "install.style.font.fira": {"icon":"","label":"Fira Code","action":"~/Work/omarchy-update-ui/omarchy-update-ui omarchy-install-font 'Fira Code' ttf-firacode-nerd 'FiraCode Nerd Font'"},
  "install.style.font.victor": {"icon":"","label":"Victor Code","action":"~/Work/omarchy-update-ui/omarchy-update-ui omarchy-install-font 'Victor Code' ttf-victor-mono-nerd 'VictorMono Nerd Font'"},
  "install.style.font.bitstream": {"icon":"","label":"Bitstream Vera Mono","action":"~/Work/omarchy-update-ui/omarchy-update-ui omarchy-install-font 'Bitstream Vera Code' ttf-bitstream-vera-mono-nerd 'BitstromWera Nerd Font'"},
